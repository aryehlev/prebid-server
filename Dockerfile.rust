# syntax=docker/dockerfile:1.6
#
# Multi-stage Dockerfile for the Rust port of Prebid Server.
# The binary package is `prebid-server` (see rust/crates/server/Cargo.toml).

# ---------------------------------------------------------------------------
# Stage 1: build
# ---------------------------------------------------------------------------
FROM rust:1.82-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the Rust workspace. We deliberately scope this to rust/ so changes in
# the Go tree do not invalidate the Docker layer cache.
COPY rust/ /build/rust/

WORKDIR /build/rust
RUN cargo build --release --workspace -p prebid-server

# ---------------------------------------------------------------------------
# Stage 2: runtime
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 2001 prebidgroup \
    && adduser --system --uid 1001 --ingroup prebidgroup prebid

COPY --from=builder /build/rust/target/release/prebid-server /usr/local/bin/prebid-server
COPY sample/rust/pbs.yaml /etc/prebid/pbs.yaml

RUN chmod a+rx /usr/local/bin/prebid-server \
    && chmod a+r /etc/prebid/pbs.yaml

USER prebid

EXPOSE 8000
EXPOSE 6060

ENTRYPOINT ["/usr/local/bin/prebid-server"]
CMD ["--config", "/etc/prebid/pbs.yaml"]
